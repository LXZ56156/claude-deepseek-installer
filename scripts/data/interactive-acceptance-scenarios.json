        "id": "disclaimer-reject",
        "entry": "00-点我开始安装.cmd",
        "timeoutSec": 90,
        "steps": [
          { "expect": "请输入 Y 确认已阅读并同意", "send": "N\r", "timeoutSec": 30 },
          { "expect": "Press any key to close this window", "send": " \r", "delayMs": 300, "timeoutSec": 30 }
